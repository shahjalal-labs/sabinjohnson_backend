datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  fullName     String
  email        String        @unique
  phoneNumber  String        @unique
  password     String?
  city         String?
  address      String?
  profileImage String?
  fcmToken     String?
  role         UserRole      @default(User)
  status       UserStatus    @default(Active)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userRide     Ridesharing[] @relation("User")
  vehicle      Vehicle?
  riderRide    Ridesharing[] @relation("Rider")
  room1        Room[]        @relation("User1")
  room2        Room[]        @relation("User2")
  riderRatings Rating[]      @relation("Rider")

  @@map("users")
}

model Vehicle {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  userId            String        @unique @db.ObjectId
  vehicleName       String
  model             String
  licensePlate      String
  vehicleImage      String?
  idFrontImage      String?
  idBackImage       String?
  licenseFrontImage String?
  licenseBackImage  String?
  status            VehicleStatus @default(Pending)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id])

  @@map("vehicles")
}

model Label {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @db.ObjectId
  labelName          String
  destinationLat     Float
  destinationLong    Float
  destinationAddress String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("labels")
}

model Ridesharing {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  userId             String            @db.ObjectId
  riderId            String            @db.ObjectId
  pickupLatitude     Float
  pickupLongitude    Float
  pickupAddress      String
  destinationLat     Float
  destinationLong    Float
  destinationAddress String
  userDistanceKm     Float
  riderDistanceKm    Float
  etaMinutes         Int
  cost               Float
  payWith            String
  status             RidesharingStatus @default(Pending)
  cancelledBy        UserRole?
  cancelReason       String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User              @relation("User", fields: [userId], references: [id])
  rider              User              @relation("Rider", fields: [riderId], references: [id])

  @@map("ridesharing")
}

model Rating {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rideId    String   @db.ObjectId
  riderId   String   @db.ObjectId
  userId    String   @db.ObjectId
  rating    Float
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rider     User     @relation("Rider", fields: [riderId], references: [id])

  @@unique([rideId, userId])
  @@map("ratings")
}

model Room {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  user1Id   String    @db.ObjectId
  user2Id   String    @db.ObjectId
  userIds   String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  user1     User      @relation("User1", fields: [user1Id], references: [id])
  user2     User      @relation("User2", fields: [user2Id], references: [id])

  @@map("rooms")
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId    String   @db.ObjectId
  senderId  String   @db.ObjectId
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  room      Room     @relation(fields: [roomId], references: [id])

  @@map("messages")
}

enum UserStatus {
  Active
  Blocked
  Deleted
}

enum UserRole {
  User
  Rider
  Food_Deliver
  Admin
}

enum VehicleStatus {
  Pending
  Approved
  Rejected
}

enum RidesharingStatus {
  Pending
  Accepted
  Started
  Completed
  Cancelled
}
