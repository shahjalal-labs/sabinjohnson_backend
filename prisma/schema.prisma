datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  fullName        String
  email           String        @unique
  phoneNumber     String        @unique
  password        String?
  city            String?
  address         String?
  profileImage    String?
  fcmToken        String?
  role            UserRole      @default(User)
  status          UserStatus    @default(Active)
  isOnline        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  userRide        Ridesharing[] @relation("User")
  vehicle         Vehicle?
  walletBalance   Float         @default(0)
  customerId      String?
  riderRide       Ridesharing[] @relation("Rider")
  room1           Room[]        @relation("User1")
  room2           Room[]        @relation("User2")
  riderRatings    Rating[]      @relation("Rider")
  userRatings     Rating[]      @relation("User")
  orders          Order[]
  paymentsAsUser  Payment[]     @relation("User")
  paymentsAsRider Payment[]     @relation("Rider")
  withdrawals     Withdrawal[]

  @@map("users")
}

enum UserStatus {
  Active
  Blocked
  Deleted
}

enum UserRole {
  User
  Rider
  Food_Deliver
  Admin
}

model Vehicle {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  userId            String        @unique @db.ObjectId
  vehicleName       String
  model             String
  licensePlate      String
  vehicleImage      String?
  idFrontImage      String?
  idBackImage       String?
  licenseFrontImage String?
  licenseBackImage  String?
  status            VehicleStatus @default(Pending)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("vehicles")
}

enum VehicleStatus {
  Pending
  Approved
  Rejected
}

model Label {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @db.ObjectId
  labelName          String
  destinationLat     Float
  destinationLong    Float
  destinationAddress String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, labelName])
  @@map("labels")
}

model Ridesharing {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  userId             String            @db.ObjectId
  riderId            String            @db.ObjectId
  pickupLatitude     Float
  pickupLongitude    Float
  pickupAddress      String
  destinationLat     Float
  destinationLong    Float
  destinationAddress String
  userDistanceKm     Float
  riderDistanceKm    Float
  etaMinutes         Int
  cost               Float
  payWith            String
  orderType          OrderType         @default(Ridesharing)
  status             RidesharingStatus @default(Pending)
  cancelledBy        UserRole?
  cancelReason       String?
  orderId            String?           @db.ObjectId
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User              @relation("User", fields: [userId], references: [id], onDelete: Cascade)
  rider              User              @relation("Rider", fields: [riderId], references: [id], onDelete: Cascade)
  payments           Payment[]

  @@map("ridesharing")
}

enum OrderType {
  Ridesharing
  FoodDelivery
}

enum RidesharingStatus {
  Pending
  Accepted
  Started
  Completed
  Paid
  Cancelled
}

model Payment {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  rideId    String        @db.ObjectId
  userId    String        @db.ObjectId
  riderId   String        @db.ObjectId
  amount    Float
  method    PaymentMethod @default(Cash)
  status    PaymentStatus @default(Completed)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  ride      Ridesharing   @relation(fields: [rideId], references: [id], onDelete: Cascade)
  user      User          @relation("User", fields: [userId], references: [id], onDelete: Cascade)
  rider     User          @relation("Rider", fields: [riderId], references: [id], onDelete: Cascade)

  @@unique([rideId, userId])
  @@map("payments")
}

enum PaymentMethod {
  BePay
  Cash
  Card
  PayPal
}

enum PaymentStatus {
  Pending
  Completed
  Failed
}

model Withdrawal {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  riderId   String           @db.ObjectId
  amount    Float
  method    PayoutMethod     @default(BePay)
  status    WithdrawalStatus @default(Pending)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  rider     User             @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@map("withdrawals")
}

enum PayoutMethod {
  PayPal
  BePay
  BankTransfer
}

enum WithdrawalStatus {
  Pending
  Completed
  Failed
}

model Category {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  categoryName String   @unique
  thumbnail    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("categories")
}

model Order {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("orders")
}

model Rating {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rideId    String   @db.ObjectId
  riderId   String   @db.ObjectId
  userId    String   @db.ObjectId
  rating    Float
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rider     User     @relation("Rider", fields: [riderId], references: [id], onDelete: Cascade)
  user      User     @relation("User", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rideId, userId])
  @@map("ratings")
}

model Room {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  user1Id   String    @db.ObjectId
  user2Id   String    @db.ObjectId
  userIds   String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  user1     User      @relation("User1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User      @relation("User2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@map("rooms")
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId    String   @db.ObjectId
  senderId  String   @db.ObjectId
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("messages")
}
