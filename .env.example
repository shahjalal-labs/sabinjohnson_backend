# MongoDB connection string
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/db_name?retryWrites=true&w=majority

# Server configuration
PORT=5010
BACKEND_BASE_URL=http://localhost:5010

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379


# Bull Board configuration
BULLBOARD_PASSWORD=admin123

# Bucket configuration
BUCKET_NAME=your_bucket_name
BUCKET_REGION=your_bucket_region
BUCKET_ACCESS_KEY=your_access_key
BUCKET_SECRET_KEY=your_secret_key
BUCKET_ENDPOINT=https://your-endpoint.com


# JWT configuration
JWT_SECRET=your_jwt_secret
JWT_COMMAND=openssl rand -hex 32
GEN_SALT=10
EXPIRES_IN=15d

# Email configuration
EMAIL=your_email@example.com
APP_PASS=your_app_password

# OpenAI configuration for GPT-3.5-turbo
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=gpt-3.5-turbo

# Encryption key for sensitive data (must be 32 bytes for AES-256)
ENCRYPTION_KEY=your_32_byte_encryption_key